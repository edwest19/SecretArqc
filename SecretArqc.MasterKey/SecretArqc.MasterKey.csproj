<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Publish Properties: this tool is meant to be portable - copy the published
    .exe to a flash drive or any folder (e.g. E:\) and run it directly, no
    installer, no dependency on .NET being present on the target machine.
    Publish with: dotnet publish -r win-x64
    Trimming is safe here (unlike SecretArqc.GenAc) since this is a plain
    console app with no WinUI/Windows App SDK runtime activation involved.
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretArqc.Core\SecretArqc.Core.csproj" />
  </ItemGroup>

</Project>
